# Copy to .env for local runs. In GitHub, add each as a repository secret.
# Never commit real values.

# SEC requires a descriptive User-Agent with a contact email
SEC_USER_AGENT="Personal Stock Research your-email@example.com"

# Free-tier keys (all optional for the probe; each one unlocks its checks)
FINNHUB_API_KEY=
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=
TIINGO_API_KEY=
STOOQ_API_KEY=
FRED_API_KEY=
BARGO_API_KEY=

# Telegram notifier (set up in Phase 4, or earlier for health checks)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Supabase (Phase 1, once the project exists)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
OWNER_EMAIL=
